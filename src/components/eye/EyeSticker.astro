---
/**
 * Round eye sticker (hero, 404, footer easter egg). Colored disc + tracking
 * eye. `closed` draws an eyelid over it that slides open on hover / [open].
 */
import EyeLogo from './EyeLogo.astro';

interface Props {
  size?: string;
  class?: string;
  track?: boolean;
  closed?: boolean;
  /** CSS color for the disc */
  fill?: string;
  title?: string;
}
const {
  size = '10.5rem',
  class: cls = '',
  track = true,
  closed = false,
  fill = 'var(--c-cyan)',
  title,
} = Astro.props;
---

<div
  class:list={['eye-sticker', { 'is-closed': closed }, cls]}
  style={`--size:${size};--disc:${fill}`}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
  <EyeLogo size="66%" variant="sticker" track={track} />
  {
    closed && (
      <span class="lid">
        <svg viewBox="0 0 48 48" focusable="false">
          <path d="M8 22Q24 36 40 22" />
          <path d="M14 28l-3 5M20 31l-1.5 5.5M28 31l1.5 5.5M34 28l3 5" />
        </svg>
      </span>
    )
  }
</div>

<style>
  .eye-sticker {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    aspect-ratio: 1;
    border: var(--border);
    border-radius: 50%;
    background: var(--disc);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  /* eyelid: an orange lid with an ink lash line */
  .lid {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--c-orange);
    transition: translate var(--dur) var(--ease-out);
  }
  .lid svg {
    width: 66%;
    fill: none;
    stroke: var(--c-ink);
    stroke-width: 3.5;
    stroke-linecap: round;
  }
</style>
