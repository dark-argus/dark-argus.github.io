---
/**
 * Search box + results. Used twice: inside the global <dialog> (opened with
 * "/", Ctrl/⌘+K or the nav button) and inline on /search/ (the no-JS-dialog
 * fallback the nav links to). Wired up by /scripts/search.ts.
 */
interface Props {
  id: string;
  autofocus?: boolean;
}
const { id, autofocus = false } = Astro.props;
---

<div class="search-ui" data-search-ui>
  <form class="search-form" role="search" action="" data-search-form>
    <label class="visually-hidden" for={`${id}-q`}>Search posts</label>
    <svg class="glass" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5"></circle><path d="M15 15l6 6"></path></svg>
    <input
      class="search-input"
      id={`${id}-q`}
      name="q"
      type="search"
      placeholder="Search research & writeups…"
      autocomplete="off"
      spellcheck="false"
      autofocus={autofocus}
      data-search-input
    />
  </form>
  <p class="search-status" role="status" aria-live="polite" data-search-status>Type to search. Esc closes.</p>
  <ol class="search-results" role="list" data-search-results></ol>
</div>

<style>
  .search-ui {
    display: grid;
    gap: 0.9rem;
  }
  .search-form {
    position: relative;
  }
  .glass {
    position: absolute;
    left: 1rem;
    top: 50%;
    translate: 0 -50%;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    min-height: 3.5rem;
    padding: 0.75rem 1rem 0.75rem 3rem;
    border: var(--border);
    background: var(--panel-2);
    color: var(--ink);
    font-family: var(--ff-mono);
    font-size: 1.05rem;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--c-lime);
  }
  .search-input:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: 3px;
  }
  .search-input::-webkit-search-cancel-button {
    filter: grayscale(1);
  }
  .search-status {
    font-family: var(--ff-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .search-results {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }
  .search-results :global(a) {
    display: grid;
    gap: 0.35rem;
    padding: 0.9rem 1.1rem;
    border: var(--border);
    background: var(--panel);
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .search-results :global(a:hover),
  .search-results :global(a:focus-visible) {
    transform: translate(-3px, -3px);
    box-shadow: 5px 5px 0 var(--c-cyan);
    outline: none;
  }
  .search-results :global(.r-kind) {
    font-family: var(--ff-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .search-results :global(.r-title) {
    font-family: var(--ff-display);
    font-size: 1.35rem;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .search-results :global(.r-excerpt) {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .search-results :global(mark) {
    background: var(--c-lime);
    color: var(--c-ink);
    padding-inline: 0.1em;
  }
</style>
