---
/**
 * Per-page SEO: title, description, canonical, Open Graph, Twitter card,
 * article metadata and feed discovery. OG images default to the
 * build-time generated card at /og/<slug>.png (see pages/og/).
 */
import { SITE } from '~site';
import { withBase } from '@/lib/url';

export interface SeoProps {
  title?: string;
  description?: string;
  /** Path (base-relative, e.g. "/og/research/foo.png") or absolute URL */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = '/og/default.png',
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
} = Astro.props as SeoProps;

const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — security research & CTF writeups`;
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, site).toString();
const imageUrl = /^https?:/.test(image) ? image : new URL(withBase(image), site).toString();
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="author" content={SITE.author.name} />
<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:site_name" content={SITE.title} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? `${title ?? SITE.title} — ${SITE.title}`} />
<meta property="og:locale" content={SITE.locale} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Feeds -->
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} — all posts`} href={withBase('/rss.xml')} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} — research`} href={withBase('/research/rss.xml')} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} — writeups`} href={withBase('/writeups/rss.xml')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
