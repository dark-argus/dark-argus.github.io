---
import { Font } from 'astro:assets';
import Seo, { type SeoProps } from '@/components/Seo.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import SearchDialog from '@/components/SearchDialog.astro';
import { SITE } from '~site';
import { withBase } from '@/lib/url';
import '@/styles/global.css';

type Props = SeoProps & { bodyClass?: string };
const { bodyClass, ...seo } = Astro.props;

/*
 * Content-Security-Policy (meta). Production only: the dev server injects
 * inline scripts + websockets for HMR, which this policy would block.
 *  - script-src 'self'        → no inline scripts anywhere (theme-init is a file)
 *  - 'wasm-unsafe-eval'       → Pagefind's search index is WebAssembly
 *  - style-src 'unsafe-inline'→ Shiki highlights with inline style="" attributes
 *                               and Astro's Font component emits a <style>. No
 *                               script execution is possible through CSS here.
 * frame-ancestors can't be set from <meta>; it's in public/_headers (Cloudflare).
 */
const csp = [
  "default-src 'self'",
  "script-src 'self' 'wasm-unsafe-eval'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data:",
  "font-src 'self'",
  "connect-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <!-- render-blocking on purpose (≈400 bytes): sets the theme before paint -->
    <script is:inline src={withBase('/theme-init.js')}></script>
    <meta name="theme-color" content="#0E0E13" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-script" />

    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog />

    <script>
      import '@/scripts/theme';
      import '@/scripts/eye-track';
      import '@/scripts/search';
    </script>
  </body>
</html>
