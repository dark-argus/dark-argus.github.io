---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import TagChip from '@/components/ui/TagChip.astro';
import { getAllPosts, tagCounts } from '@/lib/posts';

const tags = tagCounts(await getAllPosts());
---

<BaseLayout title="Tags" description="Every tag used across research and writeups.">
  <PageHeader eyebrow="// Index" title="Tags" count={tags.length} lede="Everything, grouped by what it's about." />
  <section class="section section--alt" aria-label="All tags">
    <div class="container cloud">
      {tags.map(({ tag, count }) => <TagChip tag={tag} variant="fill" count={count} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    border-top: 0;
  }
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>
